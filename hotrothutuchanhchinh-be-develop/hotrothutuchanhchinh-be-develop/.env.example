# Server Environment
NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tthc_db?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d
JWT_SESSION_REFRESH_EXPIRES_IN=8h

# CORS — nhiều frontend, cách nhau bởi dấu phẩy
# Local: http://localhost:5173
# Production: https://ten-admin.vercel.app,https://ten-fe.vercel.app
CLIENT_URL=http://localhost:5173

# Cho phép mọi subdomain *.vercel.app (preview deploy). Tắt (=false) khi production chặt
CORS_ALLOW_VERCEL_PREVIEWS=true

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Email — Gmail (bắt buộc để gửi link quên mật khẩu)
# 1. Bật xác minh 2 bước: https://myaccount.google.com/security
# 2. Tạo App Password: https://myaccount.google.com/apppasswords
# 3. Chọn "Mail" + "Windows Computer" → copy mật khẩu 16 ký tự (bỏ dấu cách khi dán)
# 4. EMAIL_FROM phải trùng SMTP_USER khi dùng Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=your-email@gmail.com

# Google Login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Digital Signature — VNPT SmartCA (Gateway sp769)
# Production: https://gwsca.vnpt.vn/sca/sp769
# UAT:        https://rmgateway.vnptit.vn/sca/sp769
SMARTCA_API_BASE=https://gwsca.vnpt.vn/sca/sp769
SMARTCA_CLIENT_ID=
SMARTCA_CLIENT_SECRET=
SMARTCA_MOBILE_CODE=
# Thuê bao từng cán bộ: gắn trên Cài đặt tài khoản (User.smartCaUserId), không đặt trong env.

# Legacy aliases (optional)
CA_API_URL=
CA_API_KEY=

# Cloudinary (avatar upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Logging
LOG_DIR=./logs
LOG_LEVEL=info

# SSL Certificate
SSL_KEY_PATH=/etc/letsencrypt/live/your-domain/privkey.pem
SSL_CERT_PATH=/etc/letsencrypt/live/your-domain/fullchain.pem
